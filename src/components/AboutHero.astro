---
import PillLink from "./PillLink.astro";
import PageHero from "./PageHero.astro";
import investor from "../assets/hero/investor.webp";

const lead =
  "Das WerkStadtForum ist ein offenes Forum für die Berliner City West. Hier diskutieren Nachbarn, Fachleute, Wirtschaft und Politik gemeinsam, wie sich die Gegend rund um [Ku'damm, Tauentzien, Breitscheidplatz und Zoo] entwickeln soll.";

const topicImg = (name: string) => `/about/topic/${name}.svg`;
---

<PageHero
  title={["Worum geht's", "hier eigentlich?"]}
  lead={lead}
  image={investor}
  flip
>
  <section class="rise-sheet about-sheet" slot="sheet" aria-labelledby="plans-title">
    <div class="about-sheet__content">
      <div class="about-sheet__intro">
        <h2 class="about-sheet__title" id="plans-title">
          Pläne gibt’s genug. Die meisten liegen in der Schublade.
        </h2>
        <p class="about-sheet__text">
          Für die City West wurden über Jahre viele Konzepte geschrieben. Umgesetzt wurde davon
          wenig. Wir glauben: Ein Plan funktioniert nur, wenn die Menschen vor Ort ihn mittragen.
          Deshalb fragen wir sie, bevor entschieden wird.
        </p>
      </div>

      <ul class="topics" aria-label="Themen">
        <li class="topic" style="--i: 0">
          <span class="topic__stage topic__stage--klima" aria-hidden="true">
            <span class="art art--sun" style="--x: 128; --y: 4; --w: 46">
              <img class="sun" src={topicImg("sun")} alt="" width="100" height="100" loading="lazy" decoding="async" />
            </span>
            <img class="art art--cloud art--cloud-a" src={topicImg("cloud")} alt="" width="110" height="60" style="--x: 8; --y: 12; --w: 48" loading="lazy" decoding="async" />
            <img class="art art--cloud art--cloud-b" src={topicImg("cloud")} alt="" width="110" height="60" style="--x: 72; --y: 30; --w: 60" loading="lazy" decoding="async" />
            <img class="art art--hills" src={topicImg("hills")} alt="" width="200" height="42" style="--x: 0; --y: 58; --w: 200" loading="lazy" decoding="async" />
            <img class="art art--tree" src={topicImg("tree")} alt="" width="60" height="100" style="--x: 28; --y: 36; --w: 30" loading="lazy" decoding="async" />
          </span>
          <span class="topic__label">Klima</span>
        </li>
        <li class="topic" style="--i: 1">
          <span class="topic__stage topic__stage--verkehr" aria-hidden="true">
            <img class="art art--skyline" src={topicImg("skyline")} alt="" width="200" height="50" style="--x: 0; --y: 20; --w: 200" loading="lazy" decoding="async" />
            <i class="art art--road" style="--x: 0; --y: 68; --w: 200; --h: 32"></i>
            <img class="art art--dash" src={topicImg("dash")} alt="" width="300" height="4" style="--x: 0; --y: 83; --w: 260; --h: 2.5" loading="lazy" decoding="async" />
            <span class="art art--bus" style="--x: 0; --y: 60; --w: 60">
              <img src={topicImg("bus")} alt="" width="140" height="50" loading="lazy" decoding="async" />
            </span>
            <span class="art art--bike" style="--x: 0; --y: 64; --w: 28">
              <img src={topicImg("bike")} alt="" width="100" height="60" loading="lazy" decoding="async" />
            </span>
            <span class="art art--car" style="--x: 0; --y: 72; --w: 50">
              <img class="car__body" src={topicImg("car-body")} alt="" width="110" height="50" loading="lazy" decoding="async" />
              <img class="car__wheel car__wheel--back" src={topicImg("wheel")} alt="" width="20" height="20" loading="lazy" decoding="async" />
              <img class="car__wheel car__wheel--front" src={topicImg("wheel")} alt="" width="20" height="20" loading="lazy" decoding="async" />
            </span>
            <img class="art art--signal" src={topicImg("signal")} alt="" width="14" height="44" style="--x: 182; --y: 28; --w: 12" loading="lazy" decoding="async" />
            <i class="art lamp lamp--red" style="--x: 185; --y: 30.5; --w: 6"></i>
            <i class="art lamp lamp--yellow" style="--x: 185; --y: 39.5; --w: 6"></i>
            <i class="art lamp lamp--green" style="--x: 185; --y: 48.5; --w: 6"></i>
          </span>
          <span class="topic__label">Verkehr</span>
        </li>
        <li class="topic" style="--i: 2">
          <span class="topic__stage topic__stage--wohnen" aria-hidden="true">
            <img class="art art--town" src={topicImg("town")} alt="" width="200" height="100" style="--x: 0; --y: 0; --w: 200" loading="lazy" decoding="async" />
            <i class="art art--lit" style="--x: 22; --y: 58; --w: 12; --h: 12; --d: 0s"></i>
            <i class="art art--lit" style="--x: 50; --y: 58; --w: 12; --h: 12; --d: 3.1s"></i>
            <i class="art art--lit" style="--x: 91; --y: 22; --w: 12; --h: 12; --d: 1.4s"></i>
            <i class="art art--lit" style="--x: 111; --y: 22; --w: 12; --h: 12; --d: 4.6s"></i>
            <i class="art art--lit" style="--x: 91; --y: 42; --w: 12; --h: 12; --d: 2.5s"></i>
            <i class="art art--lit" style="--x: 111; --y: 42; --w: 12; --h: 12; --d: 0.7s"></i>
            <i class="art art--lit" style="--x: 91; --y: 62; --w: 12; --h: 12; --d: 3.8s"></i>
            <i class="art art--lit" style="--x: 111; --y: 62; --w: 12; --h: 12; --d: 5.3s"></i>
            <i class="art art--lit" style="--x: 148; --y: 70; --w: 24; --h: 14; --d: 2s"></i>
            <i class="art art--door" style="--x: 35; --y: 68; --w: 14; --h: 22"></i>
            <i class="art art--puff" style="--x: 57; --y: 19; --w: 7; --d: 0s"></i>
            <i class="art art--puff" style="--x: 57; --y: 19; --w: 7; --d: 1.6s"></i>
            <img class="art art--awning" src={topicImg("awning")} alt="" width="62" height="14" style="--x: 138; --y: 56; --w: 62" loading="lazy" decoding="async" />
          </span>
          <span class="topic__label">Wohnen und Handel</span>
        </li>
      </ul>

      <div class="about-sheet__outro">
        <p class="about-sheet__close">Große Themen. Die klären wir lieber gemeinsam.</p>
        <PillLink href="/#mitmachen" label="Mitmachen" />
      </div>
    </div>
  </section>
</PageHero>

<style>
  .about-sheet {
    --sheet-bg: var(--yellow);
    --sheet-fg: var(--green);
  }

  .about-sheet__content {
    padding: clamp(6.5rem, 22vh, 11rem) var(--gutter) clamp(2rem, 6vh, 3.5rem);
  }

  .about-sheet__intro {
    width: min(46rem, 100%);
  }

  .about-sheet__title {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.85rem, 4.6vw, 3.15rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .about-sheet__text {
    max-width: 38rem;
    margin: clamp(1rem, 2.4vh, 1.45rem) 0 0;
    font-size: clamp(0.95rem, 0.86rem + 0.35vw, 1.125rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  /* Drei Stichworte – Grid über die volle Body-Breite, auf Mobil als Wisch-Slider */
  .topics {
    --topic-gap: clamp(0.75rem, 1.4vw, 1.25rem);
    --sky: #d3e7f3;
    --street-sky: #e8e3d4;
    --town-sky: #f6e7b6;
    --asphalt: #3b3a33;
    --white: #fdfbf5;
    --bark: #7a5230;
    --red: #d9573f;
    display: grid;
    gap: var(--topic-gap);
    margin: clamp(1.35rem, 3.2vh, 2rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .topic {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: clamp(1.1rem, 1.8vw, 1.6rem);
    background: var(--beige);
    color: var(--green);
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.7s var(--ease-out);
    transition-delay: calc(var(--i) * 90ms);
  }

  .topic.is-in {
    opacity: 1;
    transform: none;
  }

  .topic__label {
    padding: clamp(0.7rem, 1.2vw, 0.95rem) clamp(0.95rem, 1.6vw, 1.3rem) clamp(0.85rem, 1.4vw, 1.1rem);
    font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* Bühne 2:1 – Szene in 200×100 Einheiten, Ebenen per --x/--y/--w positioniert */
  .topic__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }

  .topic__stage--klima {
    background: var(--sky);
  }

  .topic__stage--verkehr {
    background: var(--street-sky);
  }

  .topic__stage--wohnen {
    background: var(--town-sky);
  }

  .art {
    position: absolute;
    display: block;
    left: calc(var(--x) / 2 * 1%);
    top: calc(var(--y) * 1%);
    width: calc(var(--w) / 2 * 1%);
  }

  .art--road,
  .art--dash,
  .art--lit,
  .art--door {
    height: calc(var(--h) * 1%);
  }

  img.art,
  .art > img {
    display: block;
    height: auto;
  }

  .art > img {
    width: 100%;
  }

  .art--dash {
    object-fit: fill;
  }

  /* Klima: Sonne dreht, Wolken ziehen, Baum wiegt sich bei Hover */
  .art--sun {
    transition: transform 0.6s var(--ease-bounce);
  }

  .sun {
    animation: sun-turn 26s linear infinite;
  }

  .art--cloud-a {
    animation: cloud-drift-a 7s ease-in-out infinite alternate;
  }

  .art--cloud-b {
    animation: cloud-drift-b 9s ease-in-out infinite alternate;
  }

  .art--tree {
    transform-origin: 50% 100%;
  }

  @keyframes sun-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cloud-drift-a {
    to {
      transform: translateX(60%);
    }
  }

  @keyframes cloud-drift-b {
    to {
      transform: translateX(-45%);
    }
  }

  @keyframes tree-sway {
    from {
      transform: rotate(-5deg);
    }
    to {
      transform: rotate(5deg);
    }
  }

  /* Verkehr: Bus und Auto fahren, Ampel schaltet, Rad kommt bei Hover */
  .art--road {
    background: var(--asphalt);
  }

  .art--dash {
    animation: dash-run 0.7s linear infinite;
  }

  .art--bus {
    animation: bus-drive 11s linear infinite;
  }

  .art--car {
    animation: car-drive 6.5s linear infinite;
  }

  .car__body {
    width: 100%;
  }

  .art--car > .car__wheel {
    position: absolute;
    top: 62%;
    width: 16.4%;
    animation: wheel-turn 0.8s linear infinite;
  }

  .car__wheel--front {
    left: 68.2%;
  }

  .car__wheel--back {
    left: 13.6%;
  }

  .art--bike {
    transform: translateX(-130%);
  }

  .lamp {
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0.18;
    animation: 6s linear infinite;
    transition: opacity 0.3s;
  }

  .lamp--red {
    background: var(--red);
    animation-name: lamp-red;
  }

  .lamp--yellow {
    background: var(--yellow);
    animation-name: lamp-yellow;
  }

  .lamp--green {
    background: var(--green-light);
    animation-name: lamp-green;
  }

  @keyframes dash-run {
    to {
      transform: translateX(-9.3333%);
    }
  }

  @keyframes car-drive {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(420%);
    }
  }

  @keyframes bus-drive {
    from {
      transform: translateX(350%);
    }
    to {
      transform: translateX(-110%);
    }
  }

  @keyframes bike-ride {
    from {
      transform: translateX(760%);
    }
    to {
      transform: translateX(-130%);
    }
  }

  @keyframes wheel-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes lamp-red {
    0%,
    55% {
      opacity: 1;
    }
    56%,
    100% {
      opacity: 0.18;
    }
  }

  @keyframes lamp-yellow {
    0%,
    44% {
      opacity: 0.18;
    }
    45%,
    55% {
      opacity: 1;
    }
    56%,
    89% {
      opacity: 0.18;
    }
    90%,
    100% {
      opacity: 1;
    }
  }

  @keyframes lamp-green {
    0%,
    55% {
      opacity: 0.18;
    }
    56%,
    89% {
      opacity: 1;
    }
    90%,
    100% {
      opacity: 0.18;
    }
  }

  /* Wohnen und Handel: Fenster gehen an, Schornstein raucht, Markise rollt aus, Tür öffnet bei Hover */
  .art--lit {
    background: var(--yellow);
    opacity: 0;
    animation: window-lit 7s ease-in-out calc(var(--d) - 7s) infinite;
    transition: opacity 0.35s;
  }

  @keyframes window-lit {
    0%,
    100% {
      opacity: 0;
    }
    25%,
    65% {
      opacity: 1;
    }
    85% {
      opacity: 0;
    }
  }

  .art--door {
    background: var(--green);
    transform-origin: 0 50%;
    transition: transform 0.55s var(--ease-out);
  }

  .art--puff {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--white);
    opacity: 0;
    animation: puff-rise 3.2s ease-out var(--d) infinite;
  }

  @keyframes puff-rise {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0.6);
    }
    15% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translateY(-240%) scale(1.7);
    }
  }

  .art--awning {
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.7s var(--ease-bounce) 0.55s;
  }

  .topic.is-in .art--awning {
    transform: scaleY(1);
  }

  /* nach den animation-Kurzschreibweisen, sonst setzen diese play-state zurück */
  .topic:not(.is-in) .art,
  .topic:not(.is-in) .sun,
  .topic:not(.is-in) .car__wheel,
  :global(.about-pin.is-offscreen) .topic .art,
  :global(.about-pin.is-offscreen) .topic .sun,
  :global(.about-pin.is-offscreen) .topic .car__wheel {
    animation-play-state: paused;
  }

  @media (hover: hover) and (pointer: fine) {
    .topic.is-in:hover {
      transform: translateY(-0.3rem);
      transition-delay: 0s;
    }

    .topic:hover .art--sun {
      transform: scale(1.12);
    }

    .topic:hover .art--tree {
      animation: tree-sway 1.4s ease-in-out infinite alternate;
    }

    .topic:hover .art--bike {
      animation: bike-ride 2.8s linear both;
    }

    .topic:hover .lamp {
      animation: none;
    }

    .topic:hover .lamp--green {
      opacity: 1;
    }

    .topic:hover .art--lit {
      animation: none;
      opacity: 1;
    }

    .topic:hover .art--door {
      transform: scaleX(0.28);
    }
  }

  /* Mobil: horizontal wischen, Karten rasten ein */
  @media (max-width: 840px) {
    .topics {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline-start: var(--gutter);
      scroll-padding-inline: var(--gutter);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .topics::-webkit-scrollbar {
      display: none;
    }

    .topics::after {
      content: "";
      flex: 0 0 max(0px, calc(var(--gutter) - var(--topic-gap)));
    }

    .topic {
      flex: 0 0 min(76%, 22rem);
      scroll-snap-align: start;
    }
  }

  .about-sheet__outro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 2rem;
    margin-top: clamp(1.15rem, 2.8vh, 1.75rem);
    padding-top: clamp(0.9rem, 2vh, 1.25rem);
    border-top: 1px solid rgb(27 74 20 / 0.22);
  }

  .about-sheet__close {
    max-width: 28rem;
    margin: 0;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.65rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  @media (max-width: 840px) and (max-height: 780px) {
    .about-sheet__content {
      padding-top: clamp(5.25rem, 14vh, 7rem);
    }

    .about-sheet__text {
      margin-top: 0.75rem;
      font-size: 0.9rem;
    }

    .topics {
      margin-top: 1rem;
    }

    .topic {
      flex-basis: min(66%, 18rem);
    }

    .about-sheet__outro {
      margin-top: 0.9rem;
      padding-top: 0.75rem;
    }

    .about-sheet__close {
      font-size: 1.05rem;
    }
  }

  @media (min-width: 841px) and (max-height: 760px) {
    .about-sheet__title {
      font-size: clamp(1.65rem, 3.6vw, 2.4rem);
    }

    .about-sheet__content {
      padding-top: calc(var(--about-nav) + 0.65rem);
      padding-bottom: clamp(1rem, 2.5vh, 1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-sheet__content {
      transform: none;
    }

    .topic,
    .topic.is-in:hover {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .art,
    .sun,
    .car__wheel,
    .topic:hover .art--tree,
    .topic:hover .art--bike {
      animation: none;
    }

    .art--cloud-a {
      transform: translateX(40%);
    }

    .art--cloud-b {
      transform: translateX(-30%);
    }

    .art--bus {
      transform: translateX(120%);
    }

    .art--car {
      transform: translateX(160%);
    }

    .art--bike {
      transform: translateX(-130%);
    }

    .art--lit,
    .lamp--green {
      opacity: 1;
    }

    .art--sun,
    .art--door,
    .art--awning {
      transform: none;
      transition: none;
    }

  }
</style>

<script>
  const aboutPin = document.querySelector<HTMLElement>("#about-pin");
  if (aboutPin) {
    new IntersectionObserver(([entry]) => {
      aboutPin.classList.toggle("is-offscreen", !entry.isIntersecting);
    }).observe(aboutPin);
  }

  /* Stichwort-Karten: Einblenden + Idle-Animationen nur im Viewport */
  const topics = document.querySelectorAll<HTMLElement>(".topic");
  if (topics.length) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      topics.forEach((t) => t.classList.add("is-in"));
    } else {
      const topicObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.target.classList.toggle("is-in", entry.isIntersecting);
          }
        },
        { threshold: 0.2 },
      );
      topics.forEach((t) => topicObserver.observe(t));
    }
  }
</script>
