---
import PillLink from "./PillLink.astro";
import { readdirSync } from "node:fs";
import { join } from "node:path";

// Vorgerasterte Köpfe (bun scripts/prepare-heads.ts) – die Original-SVGs sind zu schwer fürs Sticky-Panel.
const headFiles = readdirSync(join(process.cwd(), "public/characters/heads"))
  .filter((file) => file.endsWith(".webp"))
  .sort((a, b) => a.localeCompare(b, "de"));

const cards = [
  {
    title: "Die Foren vor Ort.",
    lines: ["Vier Mal im Jahr,", "seit 2019."],
    facts: [
      {
        term: "Für wen",
        def: "Menschen, die in der City West entscheiden: aus Politik, Verwaltung, Eigentümerschaft, Verbänden, Handel und Kultur.",
      },
      { term: "Wie oft", def: "Vier Mal im Jahr, seit 2019." },
      { term: "Wie", def: "Auf Einladung." },
    ],
    href: "/wer-ist-dabei",
    linkLabel: "Wer sitzt am Tisch?",
  },
  {
    title: "Das Online-Forum.",
    lines: ["Immer,", "wann du willst."],
    facts: [
      { term: "Für wen", def: "Für alle." },
      { term: "Wie oft", def: "Immer, wann du willst." },
      {
        term: "Wie",
        def: "Lesen ohne Anmeldung. Mitreden mit kurzer Anmeldung per E-Mail, auf Wunsch anonym.",
      },
    ],
    href: "/forum",
    linkLabel: "Zum Forum",
  },
];
---

<section class="machen" id="was-wir-machen" aria-labelledby="machen-title">
  <div class="machen__col">
    <div class="machen__panel">
      <div class="machen__sticky">
        <div class="machen__copy">
          <h2 class="machen__title" id="machen-title">Wir bringen alle an einen Tisch.</h2>
          <p class="machen__lead">
            Seit 2019 treffen sich hier alle, denen die City West nicht egal ist. Wer mitmachen will,
            ist willkommen.
          </p>
        </div>

        <ul class="heads__grid" aria-hidden="true">
          {
            headFiles.map((file) => (
              <li class="heads__item">
                <div class="heads__bubble">
                  <img
                    class="heads__img"
                    src={`/characters/heads/${file}`}
                    alt=""
                    width="360"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="machen__scroll">
      <ol class="machen__list">
        {
          cards.map((card, index) => (
            <li class="machen__item">
              <span class="machen__num" aria-hidden="true">
                {index + 1}
              </span>
              <article class="machen__card" aria-labelledby={`machen-card-${index + 1}`}>
                <h3 class="machen__card-title" id={`machen-card-${index + 1}`}>
                  {[card.title, ...card.lines].map((line) => (
                    <span class="machen__line">
                      <span class="machen__base">{line}</span>
                      <span class="machen__reveal" aria-hidden="true">
                        <span class="machen__fill">{line}</span>
                      </span>
                    </span>
                  ))}
                </h3>

                <dl class="machen__facts">
                  {card.facts.map((row) => (
                    <>
                      <dt>{row.term}</dt>
                      <dd>{row.def}</dd>
                    </>
                  ))}
                </dl>

                <PillLink href={card.href} label={card.linkLabel} variant="on-beige" />
              </article>
            </li>
          ))
        }
      </ol>

      <p class="machen__bridge">
        Was im Online-Forum diskutiert wird, landet auf dem Tisch der Foren vor Ort.
      </p>
    </div>
  </div>
</section>

<style>
  .machen {
    padding-block: 0;
    --machen-rest: var(--yellow);
    --machen-wipe: 0.9s;
    --machen-nav: calc(4.6rem + env(safe-area-inset-top, 0px));
    position: relative;
    z-index: 1;
    background: var(--beige);
    color: var(--green);
  }

  .machen__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .machen__panel {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--yellow);
  }

  .machen__sticky {
    display: flex;
    flex-direction: column;
    padding: var(--machen-nav) var(--gutter) 0.85rem;
  }

  .machen__copy {
    flex: 0 0 auto;
  }

  .machen__title {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2rem, 8.5vw, 3rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .machen__lead {
    max-width: 34rem;
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.012em;
  }

  .machen__scroll {
    position: relative;
    z-index: 1;
    background: var(--beige);
    border-radius: clamp(1.35rem, 3.2vw, 2.75rem) clamp(1.35rem, 3.2vw, 2.75rem) 0 0;
  }

  .machen__list {
    margin: 0;
    padding: clamp(1.5rem, 6vh, 3rem) var(--gutter) 0;
    list-style: none;
  }

  .machen__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: start;
    min-height: 72svh;
  }

  .machen__item:last-child {
    min-height: 58svh;
  }

  .machen__num {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    margin-top: 0.12rem;
    border-radius: 0.38rem;
    background: var(--green);
    color: var(--beige);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1;
  }

  .machen__card {
    min-width: 0;
  }

  .machen__card-title {
    margin: 0;
    font-size: clamp(2.5rem, 11.5vw, 3.5rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  /* Basis (gelb) und Füllung (grün) liegen im selben Grid-Feld: gleiche Breite,
     gleicher Umbruch. Wisch von links nach rechts: die overflow-Maske fährt von
     -100 % auf 0, die Füllung gegenläufig von +100 % auf 0 – der grüne Text steht
     dabei still, nur die Kante wandert. Beides nur transform (Compositor). */
  .machen__line {
    display: grid;
    width: fit-content;
    max-width: 100%;
  }

  .machen__base,
  .machen__reveal {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .machen__base,
  .machen__fill {
    display: block;
  }

  .machen__base {
    color: var(--machen-rest);
  }

  .machen__reveal {
    overflow: hidden;
    pointer-events: none;
    transform: translate3d(-100%, 0, 0);
  }

  .machen__fill {
    display: block;
    color: var(--green);
    transform: translate3d(100%, 0, 0);
  }

  .machen.is-ready .machen__reveal,
  .machen.is-ready .machen__fill {
    transition: transform var(--machen-wipe) var(--ease-out);
  }

  .machen.is-ready .machen__item.is-lit .machen__line:nth-child(2) .machen__reveal,
  .machen.is-ready .machen__item.is-lit .machen__line:nth-child(2) .machen__fill {
    transition-delay: 0.12s;
  }

  .machen.is-ready .machen__item.is-lit .machen__line:nth-child(3) .machen__reveal,
  .machen.is-ready .machen__item.is-lit .machen__line:nth-child(3) .machen__fill {
    transition-delay: 0.24s;
  }

  .machen__item.is-lit .machen__reveal,
  .machen__item.is-lit .machen__fill {
    transform: translate3d(0, 0, 0);
  }

  .machen__facts {
    display: grid;
    gap: 0.85rem;
    margin: clamp(1rem, 2.4vh, 1.35rem) 0 0;
  }

  .machen__facts dt {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .machen__facts dd {
    margin: 0.22rem 0 0;
    max-width: 42rem;
    color: var(--text);
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.01em;
  }

  .machen__card :global(.pill-link) {
    margin-top: clamp(1.1rem, 2.6vh, 1.45rem);
  }

  .machen__bridge {
    max-width: 34rem;
    margin: 0;
    padding: clamp(1.5rem, 4vh, 2.25rem) var(--gutter) clamp(2.5rem, 10vh, 4rem);
    color: var(--text);
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.125rem);
    font-weight: 600;
    line-height: 1.38;
    letter-spacing: -0.015em;
  }

  .heads__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.35rem, 1.6vw, 0.55rem);
    width: 100%;
    margin: clamp(1rem, 2.6vh, 1.45rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .heads__bubble {
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid var(--green);
    border-radius: 50%;
    background: var(--beige);
    contain: strict;
  }

  .heads__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 960px) {
    .machen {
      --machen-nav: calc(clamp(0.65rem, 1.5vw, 1rem) * 2 + clamp(2.5rem, 3.4vw, 3.5rem) + 0.4rem);
      background: var(--yellow);
    }

    .machen__col {
      display: grid;
      grid-template-columns: minmax(18rem, 40%) minmax(0, 1fr);
      align-items: stretch;
    }

    .machen__panel {
      position: static;
      z-index: auto;
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .machen__sticky {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      height: 100svh;
      padding: var(--machen-nav) clamp(1.25rem, 2.2vw, 2.4rem) clamp(1.1rem, 2.4vh, 1.8rem);
      overflow: hidden;
      contain: layout paint;
      isolation: isolate;
    }

    .machen__title {
      max-width: 11ch;
      font-size: clamp(2rem, 3.1vw, 3rem);
    }

    .machen__lead {
      max-width: 28rem;
      margin-top: clamp(0.85rem, 1.8vh, 1.2rem);
      font-size: clamp(0.95rem, 1.05vw, 1.125rem);
    }

    .machen__scroll {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
      min-height: 100%;
      border-radius: clamp(1.5rem, 2.8vw, 2.75rem) 0 0 0;
    }

    .machen__list {
      padding: clamp(9rem, 30vh, 18rem) clamp(1.5rem, 4vw, 4.75rem) 0
        clamp(1.35rem, 2.6vw, 2.75rem);
      container-type: inline-size;
    }

    .machen__item {
      column-gap: clamp(0.8rem, 1.2vw, 1.15rem);
      min-height: 68svh;
    }

    .machen__item:last-child {
      min-height: 52svh;
    }

    .machen__num {
      width: clamp(2.15rem, 2.6vw, 2.7rem);
      height: clamp(2.15rem, 2.6vw, 2.7rem);
      margin-top: 0.08em;
      border-radius: 0.42rem;
      font-size: clamp(1.15rem, 1.5vw, 1.45rem);
    }

    .machen__card-title {
      font-size: clamp(2.8rem, 5vw, 5.25rem);
    }

    .machen__bridge {
      padding-inline: clamp(1.35rem, 2.6vw, 2.75rem);
      padding-right: clamp(1.5rem, 4vw, 4.75rem);
      padding-bottom: clamp(3rem, 12vh, 6rem);
    }

    .heads__grid {
      flex: 1 1 auto;
      min-height: 0;
      align-content: start;
      gap: clamp(0.45rem, 0.9vw, 0.65rem);
      margin-top: clamp(1.15rem, 2.8vh, 1.75rem);
    }
  }

  @supports (font-size: 1cqi) {
    @media (min-width: 960px) {
      .machen__card-title {
        font-size: clamp(2.8rem, 7.8cqi, 5.5rem);
      }
    }
  }

  @media (min-width: 960px) and (max-height: 760px) {
    .machen__title {
      font-size: clamp(1.75rem, 2.4vw, 2.5rem);
    }

    .machen__lead {
      margin-top: 0.55rem;
      font-size: 0.9rem;
    }

    .machen__sticky {
      padding-bottom: 0.85rem;
    }
  }

  @media (max-width: 959px) and (max-height: 520px) {
    .machen__panel {
      position: relative;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .machen.is-ready .machen__reveal,
    .machen.is-ready .machen__fill {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .machen__reveal {
      display: none;
    }

    .machen__title,
    .machen__lead,
    .machen__facts dt,
    .machen__base,
    .machen__fill {
      color: CanvasText;
    }

    .machen__panel,
    .machen__num,
    .heads__bubble {
      background: Canvas;
      color: CanvasText;
      border: 1px solid CanvasText;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>(".machen");
  const items = section ? [...section.querySelectorAll<HTMLElement>(".machen__item")] : [];

  if (section && items.length) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const panel = section.querySelector<HTMLElement>(".machen__panel");

    const armFill = () => section.classList.add("is-ready");

    if (reduce.matches) {
      items.forEach((item) => item.classList.add("is-lit"));
      armFill();
    } else {
      /* Genau eine Karte ist „lit“: die, deren Titel zuletzt in die Lesezone kam.
         Die Lesezone beginnt unter dem Sticky-Panel (Mobil) bzw. unter der Nav
         (Desktop) und endet ein Stück über dem unteren Rand. */
      const inZone: HTMLElement[] = [];
      let zoneObserver: IntersectionObserver | undefined;

      const sync = () => {
        const active = inZone[inZone.length - 1];
        for (const item of items) item.classList.toggle("is-lit", item === active);
      };

      const watchZone = () => {
        zoneObserver?.disconnect();
        inZone.length = 0;
        const overlay = panel && getComputedStyle(panel).position === "sticky" ? panel.offsetHeight : 0;
        const top = overlay ? overlay + 8 : Math.round(innerHeight * 0.18);
        const bottom = overlay ? 12 : 28;
        zoneObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const item = (entry.target as HTMLElement).closest<HTMLElement>(".machen__item");
              if (!item) continue;
              const idx = inZone.indexOf(item);
              if (entry.isIntersecting && idx < 0) inZone.push(item);
              else if (!entry.isIntersecting && idx >= 0) inZone.splice(idx, 1);
            }
            sync();
          },
          { rootMargin: `-${top}px 0px -${bottom}% 0px`, threshold: 0 },
        );
        for (const item of items) {
          const title = item.querySelector(".machen__card-title");
          if (title) zoneObserver.observe(title);
        }
      };

      watchZone();
      let resizeFrame = 0;
      addEventListener(
        "resize",
        () => {
          cancelAnimationFrame(resizeFrame);
          resizeFrame = requestAnimationFrame(watchZone);
        },
        { passive: true },
      );

      const sectionObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            armFill();
            sectionObserver.disconnect();
          }
        },
        { rootMargin: "120px 0px 120px 0px", threshold: 0 },
      );
      sectionObserver.observe(section);
    }
  }
</script>
