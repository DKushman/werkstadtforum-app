---
import wordmark from "../assets/WERKSTADTFORUM.svg";

const groups = [
  {
    id: "footer-forum",
    title: "Forum",
    links: [
      { href: "#hero-sheet", label: "Worum geht's?" },
      { href: "#dabei", label: "Wer ist dabei?" },
    ],
  },
  {
    id: "footer-stadt",
    title: "Stadt",
    links: [
      { href: "#orte", label: "Was wird gebaut?" },
      { href: "#charta", label: "Charta 2040" },
    ],
  },
  {
    id: "footer-mitreden",
    title: "Mitreden",
    links: [
      { href: "#termine", label: "Termine" },
      { href: "#mitmachen", label: "Mitmachen" },
    ],
  },
  {
    id: "footer-recht",
    title: "Rechtliches",
    links: [
      { href: "/datenschutz", label: "Datenschutz" },
      { href: "/impressum", label: "Impressum" },
    ],
  },
];

const socials = [
  { href: "https://www.linkedin.com/company/werkstadtforum", label: "LinkedIn" },
  { href: "https://www.instagram.com/werkstadtforum/", label: "Instagram" },
];
---

<footer class="site-footer" data-footer>
  <div class="site-footer__content">
    <div class="site-footer__bar">
      <ul class="site-footer__social">
        {
          socials.map((link) => (
            <li>
              <a href={link.href} rel="noopener noreferrer" target="_blank">
                <span class="visually-hidden">
                  {link.label} (öffnet in neuem Tab)
                </span>
                {
                  link.label === "LinkedIn" ? (
                    <svg viewBox="2.4 2.6 16.4 18.6" aria-hidden="true" focusable="false">
                      <path
                        fill="currentColor"
                        d="M4.7 3.4a2.05 2.05 0 1 1 0 4.1 2.05 2.05 0 0 1 0-4.1zM3.1 9.2h3.2V20.6H3.1V9.2zm5.3 0h3.06v1.56h.05c.43-.8 1.48-1.66 3.05-1.66 3.26 0 3.86 2.15 3.86 4.94v6.56h-3.2v-5.82c0-1.39-.03-3.17-1.93-3.17-1.94 0-2.24 1.51-2.24 3.07v5.92H8.4V9.2z"
                      />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path
                        fill="currentColor"
                        fill-rule="evenodd"
                        d="M8 3.2h8A4.8 4.8 0 0 1 20.8 8v8a4.8 4.8 0 0 1-4.8 4.8H8A4.8 4.8 0 0 1 3.2 16V8A4.8 4.8 0 0 1 8 3.2zm8 1.7H8A3.1 3.1 0 0 0 4.9 8v8A3.1 3.1 0 0 0 8 19.1h8A3.1 3.1 0 0 0 19.1 16V8A3.1 3.1 0 0 0 16 4.9zM12 8.15a3.85 3.85 0 1 1 0 7.7 3.85 3.85 0 0 1 0-7.7zm0 1.7a2.15 2.15 0 1 0 0 4.3 2.15 2.15 0 0 0 0-4.3zM17.15 6.55a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z"
                      />
                    </svg>
                  )
                }
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="site-footer__nav" aria-label="Auf dieser Seite">
      <ul class="site-footer__cols">
        {
          groups.map((group) => (
            <li>
              <p class="site-footer__label" id={group.id}>
                {group.title}
              </p>
              <ul aria-labelledby={group.id}>
                {
                  group.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))
                }
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__bottom">
      <div class="site-footer__mark-slot">
        <img class="site-footer__mark" src={wordmark.src} alt="" width="1173" height="268" />
      </div>
      <div class="site-footer__meta">
        <p>© 2026 WerkStadtForum</p>
        <p class="site-footer__credit">von DEVDESIGN</p>
      </div>
    </div>
  </div>
</footer>

<script>
  import "../scripts/footer";
</script>

<style>
  :global(:root) {
    --footer-reveal: clamp(30rem, 72svh, 46rem);
    --footer-overlap: clamp(2.75rem, 7vh, 4.25rem);
  }

  :global(.page-sheet) {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
    margin-bottom: calc(var(--footer-reveal) - var(--footer-overlap));
    background: var(--beige);
    border-bottom-left-radius: clamp(2.75rem, 6vw, 4.75rem);
    border-bottom-right-radius: clamp(2.75rem, 6vw, 4.75rem);
  }

  .site-footer {
    position: fixed;
    z-index: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: var(--footer-reveal);
    overflow: hidden;
    background: var(--green);
    color: var(--beige);
  }

  @media (max-width: 719px) {
    .site-footer {
      visibility: hidden;
      transform: translateY(100%);
      transition:
        transform 0.55s var(--ease-out),
        visibility 0s linear 0.55s;
    }

    .site-footer.is-revealed {
      visibility: visible;
      transform: translateY(0);
      transition:
        transform 0.55s var(--ease-out),
        visibility 0s;
    }
  }

  .site-footer__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(1.25rem, 3vh, 2.25rem);
    height: 100%;
    min-height: 0;
    padding:
      calc(var(--footer-overlap) + clamp(0.85rem, 2vh, 1.35rem))
      var(--gutter)
      clamp(0.7rem, 1.8vh, 1.1rem);
  }

  .site-footer__bar {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__social a {
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(245 241 228 / 0.72);
    border-radius: 50%;
    background: rgb(245 241 228 / 0.08);
    color: var(--beige);
  }

  .site-footer__social svg {
    display: block;
    width: 1.28rem;
    height: 1.28rem;
  }

  .site-footer__nav {
    flex: 0 0 auto;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, max-content);
    justify-content: space-between;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__label {
    margin: 0 0 0.7rem;
    color: rgb(245 241 228 / 0.88);
    font-size: clamp(0.95rem, 1.15vw, 1.15rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .site-footer__cols ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__cols a,
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    min-height: 1.7rem;
    color: var(--beige);
    font-size: clamp(0.84rem, 0.95vw, 0.95rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .site-footer__cols a:hover,
  .site-footer__cols a:focus-visible,
  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .site-footer a:focus-visible {
    outline-color: var(--beige);
  }

  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    background: var(--beige);
    color: var(--green);
    text-decoration: none;
  }

  .site-footer__bottom {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    gap: clamp(0.85rem, 2vh, 1.35rem);
    min-height: 0;
  }

  .site-footer__mark-slot {
    display: flex;
    align-items: flex-end;
    min-height: 0;
  }

  .site-footer__mark {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: left bottom;
  }

  .site-footer__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    color: rgb(245 241 228 / 0.88);
    font-size: clamp(0.75rem, 0.9vw, 0.875rem);
    font-weight: 600;
  }

  .site-footer__meta p {
    margin: 0;
    white-space: nowrap;
  }

  .site-footer__credit {
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  @media (max-width: 719px) {
    :global(:root) {
      --footer-reveal: clamp(32rem, 92svh, 46rem);
    }

    .site-footer__cols {
      grid-template-columns: 1fr 1fr;
      justify-content: start;
      gap: 1.15rem 1.5rem;
    }

    .site-footer__label {
      margin-bottom: 0.2rem;
      font-size: 0.95rem;
    }

    .site-footer__cols a {
      min-height: 2rem;
      font-size: 0.9rem;
    }

    .site-footer__social a {
      width: 44px;
      height: 44px;
    }

    .site-footer__mark {
      max-height: 4.25rem;
    }
  }

  @media (max-height: 560px) {
    :global(:root) {
      --footer-reveal: 100svh;
      --footer-overlap: 1.75rem;
    }

    .site-footer__content {
      gap: 0.65rem;
    }

    .site-footer__cols a,
    .site-footer__social a {
      min-height: 1.6rem;
    }

    .site-footer__mark {
      max-height: clamp(2.5rem, 16vh, 3.75rem);
    }
  }

  @media (min-width: 720px) {
    .site-footer__content {
      transform: translateY(var(--footer-shift, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__content {
      transform: none !important;
    }
  }
</style>
