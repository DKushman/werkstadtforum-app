---
// Pfade werden in scripts/journey-line.ts aus den Kartenpositionen berechnet
---

<svg class="journey-line" aria-hidden="true" focusable="false">
  <path class="journey-line__seg" pathLength="1"></path>
  <path class="journey-line__seg" pathLength="1"></path>
  <path class="journey-line__seg" pathLength="1"></path>
  <path class="journey-line__arrow"></path>
  <circle class="journey-line__dot" r="5.5"></circle>
  <circle class="journey-line__dot" r="5.5"></circle>
  <circle class="journey-line__dot" r="5.5"></circle>
  <circle class="journey-line__dot" r="5.5"></circle>
  <circle class="journey-line__dot" r="5.5"></circle>
</svg>

<style>
  .journey-line {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    color: var(--green);
  }

  .journey-line__seg,
  .journey-line__arrow {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 640px) {
    .journey-line {
      display: none;
    }
  }

  @media (min-width: 641px) {
    .journey-line__seg,
    .journey-line__arrow {
      stroke-width: 4.5;
    }
  }

  .journey-line__seg {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .journey-line__arrow,
  .journey-line__dot {
    opacity: 0;
    transform: scale(0.4);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.35s var(--ease-bounce);
  }

  .journey-line__dot {
    fill: currentColor;
  }

  .journey-line__arrow.is-on,
  .journey-line__dot.is-on {
    opacity: 1;
    transform: scale(1);
  }

</style>
