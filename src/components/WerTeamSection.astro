---
import { Image } from "astro:assets";
import caroline from "../assets/team/caroline-lehmann.png";
import wolf from "../assets/team/wolf-uwe-rilke.png";
import andreas from "../assets/team/andreas-schulten.png";

const team = [
  { name: "Caroline Lehmann", role: "Projektleitung und Moderation", text: null, img: caroline, tone: "yellow" },
  { name: "Wolf Uwe Rilke", role: "Projektleitung und Moderation, Stadtplaner", text: null, img: wolf, tone: "green" },
  { name: "Andreas Schulten", role: null, text: null, img: andreas, tone: "blue" },
] as const;
---

<section class="team" id="team" aria-labelledby="team-title">
  <div class="team__head">
    <h2 class="team__title" id="team-title">Die Leute hinter dem Tisch.</h2>
    <p class="team__lead">
      Sie steuern das Forum, bauen das Netzwerk aus, moderieren die Diskussionen und sorgen dafür, dass am Ende
      etwas Greifbares herauskommt.
    </p>
  </div>

  <ul class="team__grid">
    {
      team.map((person, i) => (
        <li class:list={["team__card", `team__card--${person.tone}`]} style={`--i: ${i}`}>
          <div class="team__photo">
            <Image
              src={person.img}
              alt={`Porträt von ${person.name}`}
              widths={[240, 360, 480]}
              sizes="(min-width: 760px) 15rem, 60vw"
              loading="lazy"
              decoding="async"
              class="team__img"
            />
          </div>
          <h3 class="team__name">{person.name}</h3>
          <p class="team__role">
            {person.role ?? <span class="team__chip">[Rolle, z. B. Gastgeber des Podcasts]</span>}
          </p>
          <p class="team__text">{person.text ?? <span class="team__chip">[Ein Satz zur Person]</span>}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .team {
    position: relative;
    padding-inline: var(--gutter);
    background: var(--beige);
    color: var(--green);
    scroll-margin-top: 4rem;
  }

  .team__head {
    max-width: 44rem;
  }

  .team__title {
    margin: 0;
    font-size: clamp(2.3rem, 9.5vw, 4.25rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .team__lead {
    max-width: 36rem;
    margin: 0.85rem 0 0;
    color: var(--text);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .team__grid {
    display: grid;
    gap: clamp(0.9rem, 1.8vw, 1.35rem);
    margin: clamp(1.75rem, 5vh, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .team__card {
    --card-bg: var(--yellow-light);
    --card-accent: var(--yellow);
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border-radius: clamp(1.5rem, 2.6vw, 2.25rem);
    background: var(--card-bg);
  }

  .team__card--green {
    --card-bg: #d6f2c8;
    --card-accent: var(--sheet);
  }

  .team__card--blue {
    --card-bg: #d5ebf8;
    --card-accent: #7dc1ea;
  }

  /* Rundes Porträt auf Farbscheibe, wie die Stationen der Startseite */
  .team__photo {
    position: relative;
    width: min(62%, 15rem);
    aspect-ratio: 1;
    margin: 0 auto clamp(1.1rem, 2.6vh, 1.6rem);
    border-radius: 50%;
    background: var(--card-accent);
  }

  .team__img {
    position: absolute;
    inset: 6%;
    width: 88%;
    height: 88%;
    border-radius: 50%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .team__name {
    margin: 0;
    font-size: clamp(1.45rem, 2.1vw, 1.95rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .team__role {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .team__text {
    margin: 0.75rem 0 0;
    color: var(--text);
    font-size: clamp(0.975rem, 1.1vw, 1.0625rem);
    font-weight: 500;
    line-height: 1.45;
  }

  .team__chip {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border: 1.5px dashed rgb(27 74 20 / 0.45);
    border-radius: 0.45rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .team__card:hover .team__img {
      transform: scale(1.04);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .team__card {
        animation: team-rise linear both;
        animation-timeline: view();
        animation-range: entry 5% entry 55%;
      }
    }
  }

  @keyframes team-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }
  }

  @media (min-width: 760px) {
    .team__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team__img {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .team__card {
      border: 1px solid CanvasText;
    }
  }
</style>
