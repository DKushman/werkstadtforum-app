---
const goals = [
  {
    value: 3,
    suffix: "",
    unitLine: "Minuten",
    locale: false,
    text: "So oft fährt der Bus auf Ku’damm und Kantstraße.",
    accent: "var(--logo-blue)",
    bg: "#e8f4fc",
    fg: "var(--green)",
  },
  {
    value: 50,
    suffix: " %",
    locale: false,
    text: "weniger Parkplätze in den Seitenstraßen. Der Platz geht an Fuß und Rad.",
    accent: "var(--logo-purple)",
    bg: "var(--yellow-light)",
    fg: "var(--green)",
  },
  {
    value: 80,
    suffix: " %",
    locale: false,
    text: "der Dächer werden grün.",
    accent: "var(--green)",
    bg: "var(--sheet)",
    fg: "#0f5c42",
  },
  {
    value: 20000,
    suffix: "",
    locale: true,
    text: "neue Wohnungen bis 2040.",
    accent: "var(--yellow)",
    bg: "var(--green)",
    fg: "var(--forum-text)",
  },
] as const;
---

<section class="charta" id="charta" aria-labelledby="charta-heading">
  <div class="charta__pin">
    <div class="charta__head">
      <h2 class="charta__title" id="charta-heading">79 Ziele. Eine offene Stadt.</h2>
      <p class="charta__sub">
        Die <span class="charta__name">Charta 2040</span> ist unser gemeinsamer Plan für die City West. Vier Beispiele:
      </p>
    </div>
  </div>

  <div class="charta__flow" role="list">
    <div class="charta__runway" aria-hidden="true"></div>
    {
      goals.map((g, i) => (
        <>
          {i > 0 ? <div class="charta__step" aria-hidden="true" /> : null}
          <article
            class="charta__card"
            role="listitem"
            style={`--i: ${i}; --card-bg: ${g.bg}; --card-fg: ${g.fg}; --accent: ${g.accent}`}
          >
            <div class="charta__card-inner">
              <p class="charta__value-wrap">
                <span
                  class="charta__value"
                  data-value={g.value}
                  data-suffix={g.suffix}
                  data-locale={g.locale ? "true" : "false"}
                  aria-hidden="true"
                >
                  0{g.suffix}
                </span>
                {"unitLine" in g && g.unitLine ? (
                  <>
                    <br aria-hidden="true" />
                    <span class="charta__value-line" aria-hidden="true">
                      {g.unitLine}
                    </span>
                  </>
                ) : null}
                <span class="visually-hidden">
                  {g.locale ? g.value.toLocaleString("de-DE") : g.value}
                  {"unitLine" in g && g.unitLine ? ` ${g.unitLine}` : g.suffix}
                </span>
              </p>
              <p class="charta__text">{g.text}</p>
            </div>
          </article>
        </>
      ))
    }
    <div class="charta__step" aria-hidden="true"></div>
    <a
      href="#charta-ziele"
      class="charta__card charta__card--link"
      role="listitem"
      style="--i: 4; --card-bg: var(--pill-bg); --card-fg: var(--green); --accent: var(--green)"
    >
      <div class="charta__card-inner charta__card-inner--link">
        <p class="charta__link-title">Alle Ziele sehen</p>
        <p class="charta__text">Die komplette Charta 2040 mit allen 79 Zielen.</p>
      </div>
    </a>
    <div class="charta__tail" aria-hidden="true"></div>
  </div>
</section>

<script>
  import "../scripts/charta";
</script>

<style>
  @property --head-p {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .charta {
    --top-safe: calc(4.5rem + env(safe-area-inset-top, 0px));
    --bottom-safe: clamp(1.25rem, 3.5vh, 2.25rem);
    --stack-inset: clamp(1.25rem, 3vh, 2rem);
    --card-size: min(
      44rem,
      calc(100vw - 2 * var(--gutter)),
      calc(100dvh - var(--top-safe) - var(--bottom-safe) - 8rem)
    );
    --stack-mid: calc(58vh - var(--card-size) / 2);
    --stack-mid: calc(58dvh - var(--card-size) / 2);
    position: relative;
    background: var(--beige);
  }

  .charta__pin {
    position: sticky;
    top: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    height: 100vh;
    height: 100dvh;
    padding: var(--top-safe) var(--gutter) var(--bottom-safe);
    pointer-events: none;
  }

  .charta__head {
    position: relative;
    z-index: 0;
    max-width: min(48rem, 100%);
    text-align: center;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .charta__head {
      --head-scale: calc(1 - var(--head-p, 0) * 0.075);
      --head-fade: calc(1 - var(--head-p, 0) * 0.32);
      opacity: var(--head-fade);
      transform: scale(var(--head-scale));
      transform-origin: 50% 42%;
    }
  }

  @media (min-width: 641px) and (prefers-reduced-motion: no-preference) {
    .charta__head {
      transform: translate3d(0, calc(var(--lift-y, 0px) * -1), 0) scale(var(--head-scale));
    }
  }

  .charta__title {
    margin: 0;
    color: var(--green);
    font-size: clamp(2.5rem, 7.2vw, 5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .charta__sub {
    margin: clamp(0.65rem, 1.6vh, 1rem) auto 0;
    max-width: 38rem;
    color: var(--text);
    font-size: clamp(1.125rem, 1.85vw, 1.5rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .charta__name {
    display: inline-block;
    padding: 0.04em 0.22em 0.08em;
    border-radius: 0.12em;
    background: var(--green);
    color: var(--forum-text);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .charta__flow {
    position: relative;
    z-index: 2;
  }

  /* Kurzer Atem für Headline, dann Karten */
  .charta__runway {
    height: clamp(26rem, 82dvh, 44rem);
  }

  /* Abstand zwischen den Sticky-Karten */
  .charta__step {
    height: clamp(16rem, 44dvh, 28rem);
  }

  .charta__tail {
    height: clamp(2rem, 6dvh, 4rem);
  }

  .charta__card {
    position: sticky;
    top: calc(var(--stack-mid) + var(--i) * var(--stack-inset));
    z-index: calc(10 + var(--i));
    container-type: size;
    width: var(--card-size);
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    border-radius: clamp(1.25rem, 2.6vw, 2.25rem);
    background: var(--card-bg);
    color: var(--card-fg);
    box-shadow: 0 -0.5rem 2rem rgb(11 7 8 / 0.1);
    transform: translate3d(0, calc(var(--lift-y, 0px) * -1), 0);
  }

  .charta__card-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(0.75rem, 2vh, 1.25rem);
    height: 100%;
    min-height: 0;
    padding: clamp(1.25rem, 3.2vw, 2.25rem);
  }

  .charta__value-wrap {
    flex: 0 1 auto;
    min-height: 0;
    margin: 0;
    line-height: 0.9;
  }

  .charta__value {
    display: block;
    color: var(--accent);
    font-size: clamp(3.25rem, 16vw, 10rem);
    font-size: clamp(3.25rem, 58cqh, 10rem);
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .charta__value-line {
    display: block;
    color: var(--accent);
    font-size: clamp(2rem, 9.5vw, 5rem);
    font-size: clamp(2rem, 34cqh, 5rem);
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    line-height: 0.95;
  }

  .charta__text {
    flex: 0 0 auto;
    max-width: 22em;
    margin: 0;
    color: var(--card-fg);
    font-size: clamp(1rem, 1.35vw, 1.375rem);
    font-size: clamp(1rem, 5.5cqw, 1.375rem);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  .charta__card--link {
    display: block;
    text-decoration: none;
    border: clamp(2px, 0.35vw, 3px) solid var(--green);
    box-shadow: none;
    transition:
      transform 0.45s var(--ease-bounce),
      border-color 0.45s var(--ease-out);
  }

  .charta__card-inner--link {
    justify-content: center;
    gap: clamp(0.65rem, 1.6vh, 1rem);
  }

  .charta__link-title {
    margin: 0;
    color: var(--card-fg);
    font-size: clamp(2rem, 9vw, 3.75rem);
    font-size: clamp(2rem, 34cqh, 3.75rem);
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .charta__card--link:hover,
    .charta__card--link:focus-visible {
      transform: translate3d(0, calc(var(--lift-y, 0px) * -1 - 0.35rem), 0) scale(1.02);
      border-color: var(--green);
    }
  }

  @media (max-width: 640px) {
    .charta {
      --card-size: min(calc(100vw - 2 * var(--gutter)), 28rem);
    }

    .charta__pin {
      position: relative;
      height: auto;
      margin-bottom: 0;
      padding: calc(var(--top-safe) + 1.5rem) var(--gutter) clamp(1.5rem, 5vh, 2.5rem);
      pointer-events: auto;
    }

    .charta__flow {
      padding: 0 var(--gutter) clamp(1rem, 3vh, 1.5rem);
    }

    .charta__runway,
    .charta__step,
    .charta__tail {
      display: none;
      height: 0;
    }

    .charta__card {
      position: relative;
      top: auto;
      width: 100%;
      max-width: var(--card-size);
      margin: 0 auto clamp(1rem, 4vw, 1.35rem);
      transform: none;
    }

    .charta__card--link {
      margin-bottom: clamp(1rem, 4vw, 1.35rem);
    }

    .charta__value {
      font-size: clamp(2.35rem, 16vw, 4.25rem);
    }

    .charta__value-line {
      font-size: clamp(1.25rem, 9vw, 2rem);
    }

    .charta__text {
      font-size: clamp(0.9375rem, 3.8vw, 1.125rem);
    }

    .charta__card-inner {
      padding: clamp(1rem, 4vw, 1.35rem);
    }

    .charta__link-title {
      font-size: clamp(1.65rem, 9vw, 2.35rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .charta__head {
      opacity: 1;
      transform: none;
    }

    .charta__card {
      transform: none;
    }
  }
</style>
