---
/**
 * Illustrierte Karte der City West (Zoo bis Messe), inline weil CSS/JS
 * die Orte ansteuern. Koordinaten grob aus WGS84 abgeleitet:
 * x = (lon − 13.27) / 0.08 · 1000, y = (52.515 − lat) / 0.025 · 520.
 */
interface Props {
  places: ReadonlyArray<{ id: string; name: string; x: number; y: number; num: string }>;
}

const { places } = Astro.props;

const labelPos: Record<string, { x: number; y: number; anchor: "start" | "middle" | "end" }> = {
  breitscheidplatz: { x: 802, y: 250, anchor: "end" },
  hardenbergplatz: { x: 748, y: 168, anchor: "end" },
  kurfuerstendamm: { x: 600, y: 318, anchor: "middle" },
  messe: { x: 150, y: 222, anchor: "middle" },
  tauentzien: { x: 885, y: 294, anchor: "middle" },
  zoo: { x: 850, y: 92, anchor: "middle" },
};

/** Hervorgehobene Fläche bzw. Straßenzug je Ort */
const areas: Record<string, { d: string; line?: boolean }> = {
  breitscheidplatz: { d: "M800 196l36-6 10 26-36 6Z" },
  hardenbergplatz: { d: "M750 168l26-2 2 26-26 2Z" },
  kurfuerstendamm: { d: "M795 219 731 239 481 322 256 385", line: true },
  messe: { d: "M-10 140h190v225h-190Z" },
  tauentzien: { d: "M840 226 906 270", line: true },
  zoo: { d: "M795 158 665 62 935 48l5 122-105 35Z" },
};
---

<div class="map">
  <div class="map__pan">
    <svg class="map__svg" viewBox="0 0 1000 520" role="group" aria-labelledby="map-title">
      <title id="map-title">Karte der City West mit den sechs Orten</title>

      <!-- Flächen, Wasser, Straßen – rein dekorativ -->
      <g aria-hidden="true">
        <rect width="1000" height="520" fill="#ece6d5"></rect>

        <!-- Grün: Tiergarten, Zoo, Lietzensee-Park, Savignyplatz -->
        <path d="M955 0h45v140l-42 10Z" fill="#cfe3b8"></path>
        <path d="M795 158 665 62 935 48l5 122-105 35Z" fill="#cfe3b8"></path>
        <ellipse cx="256" cy="177" rx="44" ry="78" fill="#d9e6c4"></ellipse>
        <ellipse cx="619" cy="209" rx="12" ry="7" fill="#cfe3b8"></ellipse>

        <!-- Messe-Gelände, Hallen, Funkturm -->
        <rect x="-10" y="140" width="122" height="225" rx="12" fill="#e2dbc8"></rect>
        <g fill="#f3efe3">
          <rect x="4" y="156" width="40" height="52" rx="4"></rect>
          <rect x="54" y="156" width="46" height="34" rx="4"></rect>
          <rect x="4" y="222" width="30" height="60" rx="4"></rect>
          <rect x="44" y="246" width="56" height="36" rx="4"></rect>
          <rect x="4" y="296" width="96" height="50" rx="4"></rect>
        </g>
        <path d="M92 190l-8 28h16Z" fill="#8b877c"></path>

        <!-- Wasser -->
        <path d="M942 0 946 60l4 100q4 56 50 62" fill="none" stroke="#bcd9ea" stroke-width="10"></path>
        <ellipse cx="256" cy="177" rx="14" ry="52" fill="#bcd9ea"></ellipse>

        <!-- Stadtautobahn -->
        <path d="M192 0v160l-14 131 76 104 44 125" fill="none" stroke="#dcd6c4" stroke-width="12" stroke-linejoin="round"></path>

        <!-- Straßen -->
        <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
          <g stroke-width="8">
            <path d="M819 212 731 239 481 322 256 385"></path>
            <path d="M744 191 150 168"></path>
            <path d="M781 166 644 52 200 100 37 125 130 177"></path>
            <path d="M819 212 906 270 1000 280"></path>
            <path d="M819 212 1000 150"></path>
          </g>
          <g stroke-width="5">
            <path d="M775 175 731 239 700 320 690 520"></path>
            <path d="M652 191 646 267 630 520"></path>
            <path d="M540 70 540 191 538 302 520 520"></path>
            <path d="M444 70 450 191 481 322 470 520"></path>
            <path d="M900 275 646 302 356 354"></path>
            <path d="M375 191 380 60"></path>
            <path d="M256 385 300 520"></path>
          </g>
        </g>

        <!-- Plätze -->
        <circle cx="644" cy="52" r="12" fill="#fff"></circle>
        <circle cx="644" cy="52" r="5" fill="#cfe3b8"></circle>
        <circle cx="37" cy="125" r="12" fill="#fff"></circle>
        <circle cx="37" cy="125" r="5" fill="#cfe3b8"></circle>
        <rect x="474" y="315" width="14" height="14" rx="3" fill="#fff"></rect>
        <rect x="899" y="263" width="14" height="14" rx="3" fill="#fff"></rect>

        <!-- Bahn -->
        <g fill="none" stroke="#6b665a" stroke-width="3" stroke-dasharray="10 7">
          <path d="M1000 150 781 166 619 198 419 214 172 291"></path>
          <path d="M186 0 184 150 176 291 250 395 300 520"></path>
        </g>
        <g fill="#fff" stroke="#6b665a" stroke-width="3">
          <circle cx="781" cy="166" r="7"></circle>
          <circle cx="619" cy="198" r="7"></circle>
          <circle cx="419" cy="214" r="7"></circle>
          <circle cx="172" cy="291" r="7"></circle>
          <circle cx="184" cy="150" r="7"></circle>
          <circle cx="250" cy="395" r="7"></circle>
        </g>
      </g>

      <!-- Beschriftungen (dekorativ, auf Mobil ausgeblendet) -->
      <g class="map__labels" aria-hidden="true">
        <text x="470" y="183">Kantstraße</text>
        <text transform="translate(648 72) rotate(40)">Hardenbergstraße</text>
        <text transform="translate(380 92) rotate(-5)">Bismarckstraße</text>
        <text transform="translate(600 352) rotate(-6)">Lietzenburger Straße</text>
        <text transform="translate(986 60) rotate(90)">Tiergarten</text>
        <text x="256" y="276" text-anchor="middle">Lietzensee</text>
        <text transform="translate(26 352) rotate(-90)">Messe Berlin</text>
        <text x="84" y="236" text-anchor="end">Funkturm</text>
        <text x="796" y="152">Bhf Zoo</text>
        <text x="432" y="234">S Charlottenburg</text>
        <text x="160" y="312" text-anchor="end">S Westkreuz</text>
        <text x="638" y="232">Savignyplatz</text>
        <text x="481" y="347" text-anchor="middle">Adenauerplatz</text>
        <text x="906" y="322" text-anchor="middle">Wittenbergplatz</text>
        <text x="644" y="36" text-anchor="middle">Ernst-Reuter-Platz</text>
        <text x="10" y="110">Theodor-Heuss-Platz</text>
        <text x="266" y="400">Halensee</text>
      </g>

      <!-- Die Orte: anklickbar; Desktop öffnet das Popover, mobil springt es zur Kachel -->
      <g class="map__spots">
        {
          places.map((p) => {
            const l = labelPos[p.id];
            const a = areas[p.id];
            return (
              <a
                class="spot"
                href={`#ort-${p.id}`}
                data-ort={p.id}
                aria-describedby={`ort-${p.id}-text`}
              >
                <title>{p.name}</title>
                <circle class="spot__hit" cx={p.x} cy={p.y} r="26" />
                <path class:list={["spot__area", { "spot__area--line": a.line }]} d={a.d} />
                <circle class="spot__halo" cx={p.x} cy={p.y} r="34" />
                <circle class="spot__ring" cx={p.x} cy={p.y} r="22" />
                <circle class="spot__dot" cx={p.x} cy={p.y} r="13" />
                <circle class="spot__dot spot__dot--on" cx={p.x} cy={p.y} r="13" />
                <text class="spot__num" x={p.x} y={p.y} dy="0.36em" aria-hidden="true">
                  {p.num}
                </text>
                <text class="spot__num spot__num--on" x={p.x} y={p.y} dy="0.36em" aria-hidden="true">
                  {p.num}
                </text>
                <text class="spot__label" x={l.x} y={l.y} text-anchor={l.anchor}>
                  {p.name}
                </text>
              </a>
            );
          })
        }
      </g>
    </svg>
  </div>
</div>

<style>
  .map {
    --s: 1;
    --sx: 81.9%;
    --sy: 40.8%;
    position: relative;
    overflow: hidden;
    border-radius: clamp(1.25rem, 2.6vw, 1.75rem);
    background: #ece6d5;
  }

  .map__pan {
    transform-origin: 0 0;
    transition: transform 0.7s var(--ease-out);
  }

  .map__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: inherit;
  }

  .map__labels {
    fill: #6e7a62;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* ---------- Orte ---------- */

  .spot {
    --on: 0;
    cursor: pointer;
    outline: none;
  }

  /* Aktiver Ort (gesetzt durch die Sektion: data-active) */
  :global(.places[data-active="breitscheidplatz"]) .spot[data-ort="breitscheidplatz"],
  :global(.places[data-active="hardenbergplatz"]) .spot[data-ort="hardenbergplatz"],
  :global(.places[data-active="kurfuerstendamm"]) .spot[data-ort="kurfuerstendamm"],
  :global(.places[data-active="messe"]) .spot[data-ort="messe"],
  :global(.places[data-active="tauentzien"]) .spot[data-ort="tauentzien"],
  :global(.places[data-active="zoo"]) .spot[data-ort="zoo"] {
    --on: 1;
    --pulse: spot-pulse;
  }

  .spot__hit {
    fill: transparent;
    pointer-events: all;
  }

  .spot__area {
    fill: var(--yellow);
    opacity: calc(var(--on) * 0.45);
    transition: opacity 0.35s var(--ease-out);
  }

  .spot__area--line {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 12;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: calc(var(--on) * 0.9);
  }

  .spot__halo {
    fill: var(--yellow);
    opacity: calc(var(--on) * 0.55);
    transform: scale(calc(0.6 + var(--on) * 0.4));
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  /* Einmaliger Puls beim Aufleuchten */
  .spot__ring {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: var(--pulse, none) 0.9s var(--ease-out) both;
  }

  @keyframes spot-pulse {
    from {
      opacity: 0.9;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(2.1);
    }
  }

  /* Punkt: grüne und gelbe Variante übereinander, nur opacity wechselt */
  .spot__dot {
    fill: var(--green);
    stroke: #fff;
    stroke-width: 3;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-bounce);
  }

  .spot__dot--on {
    fill: var(--yellow);
    opacity: var(--on);
  }

  .spot__num {
    fill: var(--forum-text);
    font-size: 15px;
    font-weight: 800;
    text-anchor: middle;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-out);
  }

  .spot__num--on {
    fill: var(--ink);
    opacity: var(--on);
  }

  .spot__label {
    fill: var(--green);
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* Hover / Fokus */
  .spot:hover .spot__dot,
  .spot:focus-visible .spot__dot {
    transform: scale(1.18);
  }

  .spot:hover .spot__label,
  .spot:focus-visible .spot__label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .spot:focus-visible .spot__dot {
    stroke: var(--ink);
    stroke-width: 4;
  }

  /* ---------- Mobil: Karte klebt oben, zoomt auf den aktiven Ort ---------- */
  @media (max-width: 640px) {
    .map {
      --s: 1.8;
      aspect-ratio: 4 / 3;
    }

    .map__labels {
      display: none;
    }

    .map__pan {
      transform: translate(
          max(100% - 100% * var(--s), min(0%, 50% - var(--sx) * var(--s))),
          max(144.2% - 100% * var(--s), min(0%, 72.1% - var(--sy) * var(--s)))
        )
        scale(var(--s));
    }

    :global(.places[data-active="hardenbergplatz"]) .map {
      --sx: 76.5%;
      --sy: 34.8%;
    }

    :global(.places[data-active="kurfuerstendamm"]) .map {
      --sx: 60%;
      --sy: 54%;
    }

    :global(.places[data-active="messe"]) .map {
      --sx: 15%;
      --sy: 34%;
    }

    :global(.places[data-active="tauentzien"]) .map {
      --sx: 88.5%;
      --sy: 49%;
    }

    :global(.places[data-active="zoo"]) .map {
      --sx: 85%;
      --sy: 23%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map__pan,
    .spot__area,
    .spot__halo,
    .spot__dot,
    .spot__num {
      transition: none;
    }

    .spot__ring {
      animation: none !important;
    }
  }
</style>
