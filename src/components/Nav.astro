---
import Logo from "./Logo.astro";

const mainLinks = [
  { href: "#hero-sheet", label: "Worum geht's?" },
  { href: "#orte", label: "Was wird gebaut?" },
  { href: "#charta", label: "Charta 2040" },
  { href: "#termine", label: "Termine" },
  { href: "#dabei", label: "Wer ist dabei?" },
  { href: "#mitmachen", label: "Mitmachen" },
];

const subLinks = [
  { href: "#forum", label: "Forum", icon: "forum" },
  { href: "#partner", label: "Partner werden", icon: "handshake" },
  { href: "#nachrichten", label: "Kontakt", icon: "phone" },
] as const;

const legalLinks = [
  { href: "/impressum", label: "Impressum" },
  { href: "/datenschutz", label: "Datenschutz" },
  { href: "/impressum#barrierefreiheit", label: "Barrierefreiheit" },
];

const navRevealCount = mainLinks.length + subLinks.length;
---

<header class="nav">
  <div class="nav__shell">
    <button class="nav__burger nav__burger--desktop" type="button" aria-label="Menü öffnen">
      <span class="nav__burger-bars nav__burger-bars--three" aria-hidden="true"></span>
    </button>

    <button class="nav__burger nav__burger--mobile" type="button" aria-label="Menü öffnen">
      <span class="nav__burger-bars nav__burger-bars--three" aria-hidden="true"></span>
    </button>

    <a class="nav__logo" href="/" aria-label="Werk Stadt Forum – zur Startseite">
      <Logo />
    </a>

    <div class="nav__actions">
      <a class="nav__cta cta cta--forum" href="#forum">Forum</a>
      <a class="nav__cta cta cta--nachrichten" href="#nachrichten">Nachrichten</a>
    </div>
  </div>
</header>

<div
  class="nav__drawer"
  id="nav-drawer"
  data-nav-drawer
  aria-hidden="true"
  inert=""
>
  <svg class="nav__clip-def" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="nav-panel-clip" clipPathUnits="objectBoundingBox">
        <path id="nav-curve-path" d="M 0,0 L 1,0 L 1,1 L 0,1 Z" />
      </clipPath>
    </defs>
  </svg>

  <button class="nav__drawer-backdrop" type="button" tabindex="-1" aria-label="Menü schließen"></button>

  <div class="nav__panel-wrap">
    <div class="nav__panel">
      <div class="nav__panel-top">
        <button class="nav__close" type="button" aria-label="Menü schließen">
          <span class="nav__close-x" aria-hidden="true"></span>
        </button>

      </div>

      <nav class="nav__menu" aria-label="Hauptnavigation">
        <div class="nav__menu-body">
        <ul class="nav__main">
          {
            mainLinks.map((link, i) => (
              <li class="nav__reveal" style={`--nav-i:${i}; --nav-i-rev:${navRevealCount - 1 - i}`}>
                <a class="nav__menu-link" href={link.href}>
                  <span class="nav__link-window">
                    <span class="nav__link-rise">{link.label}</span>
                  </span>
                </a>
              </li>
            ))
          }
          {
            subLinks.map((link, i) => {
              const idx = mainLinks.length + i;
              return (
                <li
                  class="nav__reveal"
                  style={`--nav-i:${idx}; --nav-i-rev:${navRevealCount - 1 - idx}`}
                >
                  <a class="nav__menu-link" href={link.href}>
                    <span class="nav__link-window">
                      <span class="nav__link-rise">
                        <span class="nav__link-row">
                          {
                            link.icon === "forum" ? (
                              <svg class="nav__link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                                />
                              </svg>
                            ) : link.icon === "handshake" ? (
                              <svg class="nav__link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m11 17-2 2a2.5 2.5 0 0 1-3.5 0l-1-1a2.5 2.5 0 0 1 0-3.5l2-2M13 7l2-2a2.5 2.5 0 0 1 3.5 0l1 1a2.5 2.5 0 0 1 0 3.5l-2 2M11 17l6-6M7 13l6-6"
                                />
                              </svg>
                            ) : (
                              <svg class="nav__link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.86 19.86 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                                />
                              </svg>
                            )
                          }
                          <span>{link.label}</span>
                        </span>
                      </span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        </div>

        <ul class="nav__legal">
          {
            legalLinks.map((link) => (
              <li>
                <a class="nav__legal-link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</div>

<script>
  import "../scripts/nav";
</script>

<style>
  .nav {
    position: relative;
    z-index: 200;
    padding: clamp(0.5rem, 2vw, 1.35rem) var(--gutter) 0;
    animation: nav-in 0.6s var(--ease-out) both;
  }

  .nav__shell {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .nav__burger {
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out);
  }

  .nav__burger--desktop {
    justify-self: start;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.65rem;
  }

  .nav__burger--mobile {
    display: none;
  }

  .nav__burger-bars,
  .nav__burger-bars::before,
  .nav__burger-bars::after {
    display: block;
    width: 1.35rem;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }

  .nav__burger-bars {
    position: relative;
  }

  .nav__burger-bars--three::before,
  .nav__burger-bars--three::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .nav__burger-bars--three::before {
    top: -0.45rem;
  }

  .nav__burger-bars--three::after {
    top: 0.45rem;
  }

  .nav__logo {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    width: clamp(2.5rem, 3.4vw, 3.5rem);
  }

  .nav__actions {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: clamp(0.5rem, 1vw, 0.75rem);
  }

  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }

  /* —— Drawer —— */
  .nav__clip-def {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .nav__drawer {
    position: fixed;
    inset: 0;
    z-index: 1100;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
  }

  .nav__drawer.is-open,
  .nav__drawer.is-closing {
    pointer-events: auto;
    visibility: visible;
  }

  .nav__drawer.is-closing {
    pointer-events: none;
  }

  .nav__drawer.is-closing .nav__drawer-backdrop {
    opacity: 0;
    transition-duration: 0.42s;
  }

  .nav__drawer-backdrop {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(11 7 8 / 0.42);
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.45s var(--ease-out);
  }

  .nav__drawer.is-open .nav__drawer-backdrop {
    opacity: 1;
  }

  .nav__panel-wrap {
    position: absolute;
    inset: 0 auto 0 0;
    width: 50vw;
    height: 100%;
    transform: translate3d(-108%, 0, 0);
    transition: transform 0.52s cubic-bezier(0.55, 0.06, 0.85, 0.45);
    will-change: transform;
  }

  .nav__drawer.is-open .nav__panel-wrap {
    transform: translate3d(0, 0, 0);
    transition: transform 0.64s cubic-bezier(0.15, 0.85, 0.35, 1);
  }

  .nav__drawer.is-closing .nav__panel-wrap {
    transform: translate3d(-108%, 0, 0);
    transition: transform 0.52s cubic-bezier(0.55, 0.06, 0.85, 0.45);
  }

  .nav__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding:
      max(1.1rem, env(safe-area-inset-top, 0px) + 0.65rem)
      clamp(1.5rem, 4.5vw, 2.75rem)
      max(1.25rem, env(safe-area-inset-bottom, 0px) + 0.85rem)
      clamp(1.15rem, 3.5vw, 1.85rem);
    background: var(--green);
    color: var(--beige);
    clip-path: url(#nav-panel-clip);
    -webkit-clip-path: url(#nav-panel-clip);
  }

  .nav__panel-top {
    flex: none;
  }

  .nav__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0 0 clamp(0.85rem, 2.5vh, 1.15rem);
    padding: 0;
    border: 0;
    border-radius: 0.65rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.92;
    transition: opacity 0.2s var(--ease-out);
  }

  .nav__close:hover,
  .nav__close:focus-visible {
    opacity: 1;
  }

  .nav__close-x {
    position: relative;
    width: 1.2rem;
    height: 1.2rem;
  }

  .nav__close-x::before,
  .nav__close-x::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }

  .nav__close-x::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .nav__close-x::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .nav__menu {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .nav__menu-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    padding-block: clamp(0.5rem, 3vh, 2rem);
  }

  .nav__main,
  .nav__legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__main {
    display: flex;
    flex-direction: column;
    gap: clamp(0.12rem, 1.1vh, 0.38rem);
  }

  .nav__link-window {
    display: block;
    overflow: hidden;
    line-height: inherit;
  }

  .nav__link-rise {
    display: block;
    will-change: transform;
    transform: translate3d(0, 110%, 0);
  }

  .nav__drawer.is-open .nav__reveal .nav__link-rise {
    transform: translate3d(0, 0, 0);
    transition: transform 0.58s var(--ease-out);
    transition-delay: calc(0.14s + var(--nav-i) * 0.048s);
  }

  .nav__drawer.is-closing .nav__reveal .nav__link-rise {
    transform: translate3d(0, 110%, 0);
    transition: transform 0.48s var(--ease-out);
    transition-delay: calc(var(--nav-i-rev) * 0.042s);
  }

  .nav__drawer:not(.is-open):not(.is-closing) .nav__reveal .nav__link-rise {
    transform: translate3d(0, 110%, 0);
    transition: none;
  }

  .nav__menu-link {
    position: relative;
    z-index: 0;
    display: inline-block;
    max-width: 100%;
    padding: 0.12em 0.32em;
    margin-inline: -0.32em;
    color: var(--beige);
    font-size: clamp(1.55rem, 4.35vw, 2.55rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-decoration: none;
    isolation: isolate;
  }

  .nav__menu-link::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 0.22rem;
    background: rgb(179 231 155 / 0.32);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.36s var(--ease-out);
  }

  .nav__link-row {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
  }

  .nav__link-icon {
    display: block;
    width: 0.82em;
    height: 0.82em;
    flex: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__menu-link:hover::before,
    .nav__menu-link:focus-visible::before {
      transform: scaleX(1);
    }
  }

  .nav__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.95rem;
    flex: none;
    margin-top: auto;
    padding-top: clamp(1rem, 3vh, 1.65rem);
  }

  .nav__menu-link:focus-visible,
  .nav__legal-link:focus-visible,
  .nav__close:focus-visible {
    outline: 2px solid var(--beige);
    outline-offset: 0.2em;
  }

  .nav__legal-link {
    color: rgb(245 241 228 / 0.72);
    font-size: clamp(0.68rem, 2vw, 0.76rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: opacity 0.2s var(--ease-out);
  }

  .nav__legal-link:hover,
  .nav__legal-link:focus-visible {
    opacity: 0.95;
    color: var(--beige);
  }

  :global(html.nav-open) {
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__burger--desktop:hover {
      background: rgb(11 7 8 / 0.06);
    }
  }

  @media (min-width: 641px) {
    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 999;
      padding: clamp(0.65rem, 1.5vw, 1rem) var(--gutter);
      background: transparent;
    }

  }

  @media (max-width: 640px) {
    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 999;
      padding: max(0.4rem, env(safe-area-inset-top, 0px)) var(--gutter) 0;
      pointer-events: none;
    }

    .nav__shell {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.65rem;
      padding: 0.5rem 0.75rem 0.5rem 0.65rem;
      border-radius: 1.35rem;
      background: #fff;
      box-shadow: 0 0.35rem 1.75rem rgb(11 7 8 / 0.1);
    }

    .nav__burger--mobile {
      order: 1;
    }

    .nav__logo {
      order: 2;
      margin-left: auto;
    }

    .nav__burger--desktop {
      display: none;
    }

    .nav__actions {
      display: none;
    }

    .nav__burger--mobile {
      display: grid;
      flex: none;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 0.65rem;
    }

    .nav__panel {
      padding-inline: clamp(1rem, 4.5vw, 1.35rem);
      clip-path: none;
      -webkit-clip-path: none;
    }

    .nav__menu-link {
      font-size: clamp(1.52rem, 6.8vw, 2.05rem);
      line-height: 1.06;
      padding-block: 0.14em;
    }

    .nav__main {
      gap: clamp(0.2rem, 1.4vh, 0.45rem);
    }

    .nav__menu {
      justify-content: flex-end;
    }

    .nav__menu-body {
      flex: none;
      margin-top: auto;
      justify-content: flex-end;
      padding-top: 0;
      padding-bottom: clamp(0.65rem, 2.5vh, 1.1rem);
    }

    .nav__legal {
      margin-top: 0;
      padding-top: clamp(0.75rem, 2.5vh, 1.1rem);
      border-top: 1px solid rgb(245 241 228 / 0.16);
    }

    .nav__panel-wrap {
      width: 100%;
    }

    .nav__drawer.is-closing .nav__panel-wrap {
      transform: translate3d(-102%, 0, 0);
    }

    .nav__drawer:not(.is-open):not(.is-closing) .nav__panel-wrap {
      transform: translate3d(-102%, 0, 0);
    }

  }

  @media (max-width: 640px) and (hover: hover) {
    .nav__burger--mobile:hover {
      background: rgb(11 7 8 / 0.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      animation: none;
    }

    .nav__link-rise {
      transform: none;
      transition: none !important;
    }

    .nav__panel-wrap,
    .nav__drawer-backdrop {
      transition: none;
    }

    .nav__drawer:not(.is-open):not(.is-closing) .nav__panel-wrap {
      transform: translate3d(-108%, 0, 0);
    }

    .nav__drawer.is-open .nav__panel-wrap {
      transform: translate3d(0, 0, 0);
    }
  }
</style>
