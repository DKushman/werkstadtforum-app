---
import Nav from "./Nav.astro";
import PillLink from "./PillLink.astro";
import ProcessCards from "./ProcessCards.astro";
import ForumSection from "./ForumSection.astro";
import JourneyLine from "./JourneyLine.astro";
import scene from "../assets/scene.json";
import "../styles/scene.css";

const words = ["planen", "bauen", "gestalten"];

const sheetFirst =
  "Wir bringen alle an einen Tisch, bevor über die City West entschieden wird.";
const sheetRest =
  "Nachbarn, Planerinnen, Händler, Kultur und Politik. Gemeinsam klären wir, wie unser Stadtteil in Zukunft aussehen soll.";
---

<div class="hero-pin" id="hero-pin">
<Nav />
<div class="hero" data-hero>
  <div class="hero__screen">
    <main class="hero__main">
      <div class="hero__head">
        <div class="hero__title">
          <h1 class="headline" id="hero-title">
            <span class="line"><span class="line__in">Lasst</span></span>
            <span class="line"><span class="line__in">Uns</span></span>
            <span class="line"><span class="line__in">Berlin City West</span></span>
            <span class="line line--rotator">
              <span class="visually-hidden">{words.join(", ")}</span>
              <span class="line__in rotator" aria-hidden="true">
                <span class="rotator__track">
                  {[...words, words[0]].map((w) => <span class="rotator__word">{w}</span>)}
                </span>
              </span>
            </span>
          </h1>
          <p class="hero__subline">
            <span class="hero__subline-in">
              Das offene Forum für alle, die bei der Zukunft der City West mitreden wollen.
            </span>
          </p>
        </div>
      </div>
    </main>
  </div>

  <div class="scene">
    <div class="stage" id="hero-stage">
      <div class="stage__grow" id="hero-stage-grow">
        <Fragment set:html={scene.base + scene.layers} />
      </div>
    </div>
  </div>

  <section class="sheet" id="hero-sheet" aria-labelledby="sheet-heading">
    <div class="sheet__content">
      <p class="sheet__lead" id="sheet-heading">
        <strong class="sheet__lead-strong">{sheetFirst}</strong>{" "}
        <span class="sheet__lead-rest">{sheetRest}</span>
      </p>
      <PillLink href="#" label="Mehr zu uns" />
    </div>
  </section>
</div>
</div>
<div class="hero-follow" id="hero-follow">
  <JourneyLine />
  <ProcessCards />
  <ForumSection />
</div>

<script>
  import "../scripts/hero";
</script>

<style>
  .hero-pin {
    --p: 0;
  }

  .hero__screen {
    display: contents;
  }

  .hero {
    display: flex;
    flex-direction: column;
    background: var(--beige);
  }

  /* Desktop: Scroll-Pin, grüne Fläche, Tonung */
  @media (min-width: 641px) {
    .hero {
      padding-top: calc(clamp(0.65rem, 1.5vw, 1rem) * 2 + clamp(2.5rem, 3.4vw, 3.5rem));
    }

    .hero-pin {
      height: 240vh;
      height: 240svh;
    }

    .hero {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
    }
  }

  /* Beige wird beim Scrollen gräulich – liegt hinter Inhalt und grüner Fläche, SVG bleibt vorn */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: calc(var(--p) * 0.92);
    background: var(--beige-muted);
  }

  .sheet {
    z-index: 3;
    border-radius: clamp(1.5rem, 3.2vw, 2.75rem) clamp(1.5rem, 3.2vw, 2.75rem) 0 0;
    background: var(--sheet);
    pointer-events: none;
  }

  .sheet__content {
    pointer-events: auto;
    width: 100%;
    max-width: none;
    padding: clamp(1.75rem, 4.5vh, 3.25rem) var(--gutter) clamp(1.5rem, 3vh, 2rem);
    text-align: left;
  }

  .sheet__lead {
    max-width: min(56rem, 68vw);
    margin: 0 0 clamp(1.35rem, 3.2vh, 2.25rem);
    font-size: clamp(1.65rem, 3.35vw, 3.15rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--green);
  }

  .sheet__lead-strong {
    font-weight: 800;
  }

  .sheet__lead-rest {
    font-weight: 500;
  }

  /* Desktop: animierte grüne Fläche im Pin */
  @media (min-width: 641px) {
    .sheet {
      position: absolute;
      top: calc(60% * (1 - var(--p)));
      right: 0;
      bottom: 0;
      left: 0;
      transform: translateY(calc((1 - var(--p)) * 100%));
    }
  }

  .hero__main {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }

  /* Szene sitzt neben main, damit sticky bis über die grüne Fläche reicht */
  .hero > .scene {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: auto;
  }

  /* ---------- Headline ---------- */

  .hero__head {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    padding: clamp(0.35rem, 1.2vh, 0.85rem) var(--gutter) 0;
    text-align: center;
    filter: brightness(calc(1 - var(--p) * 0.22));
  }

  .hero__title {
    width: 100%;
  }

  .hero__subline {
    max-width: min(22rem, 88vw);
    margin: clamp(0.65rem, 1.8vh, 1.1rem) auto 0;
    overflow: hidden;
    font-size: clamp(0.8125rem, 1.05vw, 1rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--green);
  }

  .hero__subline-in {
    display: block;
    animation: line-in 0.9s var(--ease-out) 0.32s both;
  }

  .headline {
    --fs: clamp(2.45rem, 6.2vw, 7.75rem);
    --lh: 0.8;
    --pad: 0.12em; /* Luft für Ober-/Unterlängen innerhalb der Masken */
    font-size: var(--fs);
    font-weight: 800;
    line-height: var(--lh);
    letter-spacing: -0.07em;
    color: var(--green);
    padding-bottom: var(--pad);
  }

  /* Masken mit Innenabstand, damit nichts abgeschnitten wird; negative margin-bottom gleicht ihn
     wieder aus (nur unten, damit keine Margin-Collapse entsteht) */
  .line {
    display: block;
    overflow: hidden;
    padding-block: var(--pad);
    margin-bottom: calc(var(--pad) * -2);
  }

  .line:first-child {
    margin-top: calc(var(--pad) * -1);
  }

  .line:last-child {
    margin-bottom: calc(var(--pad) * -1);
  }

  .line__in {
    display: block;
    animation: line-in 0.9s var(--ease-out) both;
  }

  .line:nth-child(2) .line__in {
    animation-delay: 0.08s;
  }
  .line:nth-child(3) .line__in {
    animation-delay: 0.16s;
  }
  .line:nth-child(4) .line__in {
    animation-delay: 0.24s;
  }

  @keyframes line-in {
    from {
      transform: translateY(110%);
    }
  }

  /* ---------- Wort-Rotation (rein CSS) ---------- */

  .line.line--rotator {
    overflow: hidden;
  }

  .rotator {
    /* --step = Scroll-Takt; sichtbare Höhe etwas enger oben, unten mehr Luft */
    --step: calc(var(--lh) * 1em + var(--pad) * 2 + 0.12em);
    --view: calc(var(--lh) * 1em + var(--pad) * 2 + 0.04em);
    height: var(--view);
    overflow: hidden;
    color: var(--ink);
  }

  .rotator__track {
    display: block;
    margin-top: -0.07em;
    will-change: transform;
    animation: rotate-words 8.4s 1.6s infinite;
  }

  .rotator__word {
    display: block;
    height: var(--step);
    padding-block: var(--pad);
    padding-bottom: calc(var(--pad) + 0.1em);
    line-height: var(--lh);
  }

  /* 3 Wörter + Kopie des ersten -> nahtloser Loop. Kein Fade: ein Wort geht nach oben, das nächste kommt von unten. */
  @keyframes rotate-words {
    0%,
    26.5% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    }
    33.33%,
    59.83% {
      transform: translateY(calc(var(--step) * -1));
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    }
    66.67%,
    93.17% {
      transform: translateY(calc(var(--step) * -2));
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    }
    100% {
      transform: translateY(calc(var(--step) * -3));
    }
  }

  /* ---------- Szene ---------- */

  .scene {
    --scene-grow: 1.06;
    --scene-scale: 1.08;
    /* Anteil der Illustration, der initial unter dem Fold liegt – geräteübergreifend gleich */
    --scene-reveal: 14%;
    --scene-nudge-x: clamp(0.5rem, 1.4vw, 1.35rem);
    position: sticky;
    bottom: 0;
    z-index: 4;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    margin-top: auto;
    pointer-events: none;
    container-type: size;
    animation: scene-in 1.1s var(--ease-bounce) 0.2s both;
  }

  @keyframes scene-in {
    from {
      opacity: 0;
      transform: translateY(12%) scale(0.96);
    }
  }

  /* Ganzes SVG im Seitenverhältnis 950/430, unten mittig. Die Breite lässt Luft fürs Scroll-Wachstum. */
  .stage {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(
      calc(100cqw * var(--scene-scale) / var(--scene-grow)),
      calc(100cqh * 950 / 430 * var(--scene-scale) / var(--scene-grow))
    );
    aspect-ratio: 950 / 430;
    transform: translate(calc(-50% - var(--scene-nudge-x)), 0);
    pointer-events: auto;
  }

  .stage__grow {
    position: absolute;
    inset: 0;
    transform-origin: center bottom;
    transform: translateY(calc((1 - var(--p)) * var(--scene-reveal)))
      scale(calc(1 + var(--p) * (var(--scene-grow) - 1)));
  }

  .stage__grow > :global(svg) {
    position: absolute;
    display: block;
  }

  .stage__grow :global(.scene__base) {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Desktop: Headline beim Scrollen leicht verkleinern */
  @media (min-width: 641px) {
    .hero__main {
      flex: 0 0 auto;
    }

    .hero > .scene {
      flex: 1 1 auto;
      min-height: 0;
    }

    .hero__head {
      padding-top: clamp(1.75rem, 5vh, 3.25rem);
    }

    .hero__subline {
      max-width: min(26rem, 42vw);
      font-size: clamp(0.875rem, 1.1vw, 1.0625rem);
    }

    .hero__title {
      transform: scale(calc(1 - var(--p) * 0.16))
        translateY(calc(var(--p) * -4.5vh));
      transform-origin: top center;
    }
  }

  /* Tablet / mittlere Breiten: mehr Luft nach oben, wenn die SVG enger wird */
  @media (min-width: 641px) and (max-width: 1100px) {
    .hero__head {
      padding-top: clamp(2rem, 7vh, 3.75rem);
    }
  }

  @media (min-width: 641px) and (max-height: 860px) {
    .hero__head {
      padding-top: clamp(2.25rem, 8vh, 4rem);
    }
  }

  /* Mobil: sichtbarer Viewport (svh) + Beige-Fill bis Notch/Home-Indicator */
  @media (max-width: 640px) {
    .hero-pin {
      position: relative;
      overflow: visible;
      background: var(--beige);
    }

    /* Sticky-Viewport-Trick: Beige bleibt hinter Safari-Chrome sichtbar */
    .hero-pin::before {
      content: "";
      display: block;
      position: sticky;
      top: 0;
      z-index: 0;
      height: 100svh;
      margin-bottom: -100svh;
      background: var(--beige);
      pointer-events: none;
    }

    .hero-pin > :global(.nav),
    .hero-pin > .hero {
      position: relative;
      z-index: 1;
    }

    .hero {
      --mobile-nav: clamp(4rem, 11vw, 4.75rem);
      --scene-mobile-h: clamp(15rem, 44dvh, 22.5rem);
      --sheet-scroll-h: 70svh;
      --sheet-scroll-h: 70dvh;
      position: relative;
      display: flex;
      flex-direction: column;
      padding-top: 0;
      min-height: 0;
      overflow: visible;
    }

    .hero::before {
      display: none;
    }

    .hero__screen {
      display: flex;
      flex: none;
      flex-direction: column;
      box-sizing: border-box;
      width: 100%;
      /* Headline-Bereich: erste Viewport-Hälfte minus Szene (Szene ist Geschwister für sticky) */
      height: calc(100svh - var(--scene-mobile-h) - env(safe-area-inset-bottom, 0px));
      max-height: calc(100svh - var(--scene-mobile-h) - env(safe-area-inset-bottom, 0px));
      padding-top: calc(var(--mobile-nav) + max(0.65rem, env(safe-area-inset-top, 0px)));
      padding-bottom: 0;
      background: transparent;
    }

    .sheet {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      width: 100%;
      flex: none;
      min-height: var(--sheet-scroll-h);
      margin-top: 0;
      transform: none;
    }

    .sheet__content {
      max-width: none;
      padding: clamp(1.5rem, 5vw, 2rem) var(--gutter) clamp(1.25rem, 4vw, 1.75rem);
    }

    .sheet__lead {
      max-width: min(36rem, 96vw);
      font-size: clamp(1.45rem, 6.2vw, 2.05rem);
      line-height: 1.02;
      margin-bottom: clamp(1.15rem, 4vw, 1.65rem);
    }

    .hero__main {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .hero__head {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      width: 100%;
      min-height: 0;
      padding: clamp(1rem, 4.5dvh, 2rem) var(--gutter) clamp(0.5rem, 2dvh, 1rem);
      text-align: center;
      filter: none;
    }

    .hero__subline {
      max-width: min(20rem, 92vw);
      margin-top: clamp(0.5rem, 2.5vw, 0.85rem);
      font-size: clamp(0.8125rem, 3.4vw, 0.9375rem);
      line-height: 1.1;
    }

    .headline {
      --fs: 11.8vw;
      --lh: 0.78;
      width: 100%;
      max-width: 100%;
      margin-top: auto;
    }

    .rotator__track {
      margin-top: -0.08em;
    }

    .hero > .scene {
      --scene-grow: 1;
      --scene-scale: 1.12;
      --scene-nudge-x: clamp(0.65rem, 2.8vw, 1.1rem);
      flex: none;
      position: sticky;
      bottom: 0;
      z-index: 4;
      width: 100%;
      height: calc(var(--scene-mobile-h) + env(safe-area-inset-bottom, 0px));
      padding-bottom: env(safe-area-inset-bottom, 0px);
      box-sizing: border-box;
      container-type: size;
      pointer-events: none;
    }

    .stage {
      position: absolute;
      bottom: 0;
      left: 50%;
      width: min(
        calc(100cqw * var(--scene-scale) / var(--scene-grow)),
        calc(100cqh * 950 / 430 * var(--scene-scale) / var(--scene-grow))
      );
      transform: translate(calc(-50% - var(--scene-nudge-x)), 0);
      pointer-events: auto;
    }

    .stage__grow {
      transform: none;
    }

    .hero-follow {
      min-height: 40svh;
      min-height: 40dvh;
    }
  }

  /* Nach dem Lösen scrollt der Hero weg; darunter läuft die grüne Fläche weiter. */
  .hero-follow {
    position: relative;
    background: var(--sheet);
    border-radius: 0 0 clamp(1.5rem, 3.2vw, 2.75rem) clamp(1.5rem, 3.2vw, 2.75rem);
  }

  @media (min-width: 641px) {
    .hero-follow {
      min-height: 100svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pin {
      height: auto;
    }

    .line__in,
    .hero__subline-in,
    .rotator__track,
    .scene {
      animation: none;
    }

    .hero-pin {
      --p: 0;
    }

    .hero__title {
      transform: none;
    }

    @media (min-width: 641px) {
      .sheet {
        transform: translateY(100%);
      }
    }

    .stage__grow {
      transform: none;
    }

  }
</style>
