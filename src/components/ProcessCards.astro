---
import PillLink from "./PillLink.astro";

const cards = [
  {
    title: "Erst reden, dann bauen.",
    text: "Wir sammeln Meinungen, bevor entschieden wird. Nicht danach.",
    accent: "#1b4a14",
    barFg: "#cdf0a3",
    align: "left",
    step: "01",
    tilt: "-4deg",
    tiltThrow: "-11deg",
  },
  {
    title: "Jede Stimme zählt gleich.",
    text: "Ob Anwohnerin, Architekt oder Stadtrat: Hier hat jeder dasselbe Rederecht.",
    accent: "#c95d32",
    barFg: "#fff8f2",
    align: "right",
    step: "02",
    tilt: "3.5deg",
    tiltThrow: "10.5deg",
  },
  {
    title: "Aus Meinungen wird ein Plan.",
    text: "So ist die Charta 2040 entstanden: 79 Ziele für die City West.",
    accent: "var(--accent-blue)",
    barFg: "var(--accent-blue-fg)",
    align: "left",
    step: "03",
    tilt: "-3deg",
    tiltThrow: "-10deg",
    link: { href: "#charta", label: "Zur Charta" },
  },
] as const;
---

<section class="process" id="process-cards" aria-labelledby="process-heading">
  <h2 class="visually-hidden" id="process-heading">So entsteht die City West gemeinsam</h2>
  <ul class="process__list">
    {
      cards.map((card, index) => (
        <li
          class={`process-card process-card--${card.align}`}
          style={`--card-accent: ${card.accent}; --card-bar-fg: ${card.barFg}; --card-tilt: ${card.tilt}; --card-tilt-throw: ${card.tiltThrow}; --pop-i: ${index}`}
        >
          <article class="process-card__frame" tabindex="0">
            <header class="process-card__bar">
              <span class="process-card__step" aria-hidden="true">
                {card.step}
              </span>
              <span class="process-card__icon" aria-hidden="true">
                {card.step === "01" && (
                  <svg width="40" height="40" viewBox="0 0 18 18" fill="none">
                    <path
                      d="M3 4.5h12v7.5H6.5L3 15V4.5Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {card.step === "02" && (
                  <svg width="40" height="40" viewBox="0 0 18 18" fill="none">
                    <circle cx="5" cy="6" r="2" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="13" cy="6" r="2" stroke="currentColor" stroke-width="1.5" />
                    <path
                      d="M2.5 14c0-2.2 1.8-3.5 2.5-3.5S7.5 11.8 7.5 14M10.5 14c0-2.2 1.8-3.5 2.5-3.5s2.5 1.3 2.5 3.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
                {card.step === "03" && (
                  <svg width="40" height="40" viewBox="0 0 18 18" fill="none">
                    <path
                      d="M4 3.5h10v11H4V3.5Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M6.5 7h5M6.5 9.5h5M6.5 12h3"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
              </span>
            </header>
            <div class="process-card__panel">
              <h3 class="process-card__title">{card.title}</h3>
              <p class="process-card__text">{card.text}</p>
              {"link" in card && (
                <div class="process-card__cta">
                  <PillLink href={card.link.href} label={card.link.label} />
                </div>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .process {
    position: relative;
    width: 100%;
    padding: clamp(3.25rem, 11vh, 6rem) var(--gutter) clamp(2.75rem, 8vh, 5rem);
    overflow: hidden;
  }

  .process__list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 7vh, 4.25rem);
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-card {
    width: min(100%, clamp(17.5rem, 92vw, 30rem));
    opacity: 0;
    transform: translateY(-2.75rem) rotate(var(--card-tilt-throw));
    transform-origin: center center;
  }

  .process-card.is-inview {
    animation: process-throw 0.6s var(--ease-throw) forwards;
  }

  @keyframes process-throw {
    0% {
      opacity: 0;
      transform: translateY(-2.75rem) rotate(var(--card-tilt-throw));
    }

    62% {
      opacity: 1;
      transform: translateY(0.2rem) rotate(calc(var(--card-tilt) + 0.8deg));
    }

    100% {
      opacity: 1;
      transform: translateY(0) rotate(var(--card-tilt));
    }
  }

  .process-card.is-inview:hover,
  .process-card.is-inview:focus-within {
    transform: translateY(-0.28rem) rotate(0deg);
    transition: transform 0.2s var(--ease-out);
  }

  .process-card--left {
    align-self: flex-start;
  }

  .process-card--right {
    align-self: flex-end;
  }

  .process-card:nth-child(2) {
    margin-top: 0;
  }

  .process-card:nth-child(3) {
    margin-top: 0;
  }

  .process-card__frame {
    border: 0.32rem solid var(--card-accent);
    border-radius: clamp(1.45rem, 3.2vw, 1.9rem);
    padding: clamp(0.28rem, 0.75vw, 0.38rem);
    background: var(--card-accent);
    outline: none;
  }

  .process-card__frame:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 4px;
  }

  .process-card__bar {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    overflow: hidden;
    min-height: clamp(2.35rem, 6vw, 2.85rem);
    padding: 0.15rem 0.55rem 0;
    color: var(--card-bar-fg);
  }

  /* Ziffern sitzen bewusst ein Drittel hinter der weißen Fläche */
  .process-card__step {
    font-size: clamp(3.25rem, 11vw, 4.75rem);
    font-weight: 800;
    line-height: 0.78;
    letter-spacing: -0.06em;
    translate: -0.06em 0.2em;
  }

  .process-card__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-self: center;
    margin-bottom: 0.15rem;
    opacity: 0.95;
  }

  .process-card__panel {
    padding: clamp(0.95rem, 2.4vw, 1.2rem) clamp(1.15rem, 3vw, 1.45rem)
      clamp(1rem, 2.2vw, 1.15rem);
    border-radius: clamp(1.05rem, 2.4vw, 1.45rem);
    background: #fff;
    text-align: center;
  }

  .process-card__title {
    margin: 0 0 clamp(0.4rem, 1.1vh, 0.55rem);
    color: var(--ink);
    font-size: clamp(1.85rem, 5.8vw, 2.35rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .process-card__text {
    margin: 0 auto;
    max-width: 24em;
    color: var(--green);
    font-size: clamp(0.9375rem, 2.8vw, 1.0625rem);
    font-weight: 600;
    line-height: 1.32;
  }

  .process-card__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(0.65rem, 1.6vh, 0.9rem);
  }

  @media (min-width: 641px) {
    .process {
      padding-top: clamp(2rem, 6vh, 3.75rem);
    }

    .process__list {
      gap: clamp(0.1rem, 0.45vh, 0.35rem);
    }

    .process-card {
      width: min(100%, 40rem);
    }

    .process-card__title {
      font-size: clamp(2rem, 2.75vw, 2.55rem);
    }

    .process-card__text {
      font-size: clamp(1rem, 1.25vw, 1.125rem);
    }

    .process-card__step {
      font-size: clamp(3.75rem, 5.5vw, 5.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-card {
      opacity: 1;
      transform: rotate(var(--card-tilt));
      animation: none;
    }

    .process-card.is-inview {
      animation: none;
      opacity: 1;
      transform: rotate(var(--card-tilt));
    }

    .process-card.is-inview:hover,
    .process-card.is-inview:focus-within {
      transform: rotate(0deg);
      transition: none;
    }
  }
</style>
